# Dependencies
node_modules/
frontend/node_modules/
backend/vendor/

# Build / runtime
dist/
dist-ssr/
frontend/dist/
backend/public/build/
backend/public/hot
backend/public/storage
# SPA is built locally (frontend npm run build) and committed so the
# live server can git pull without running Node.
backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
!backend/storage/logs/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore

# Env / secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
*.local

# OS / IDE
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# PHP / testing
backend/.phpunit.result.cache
backend/Homestead.json
backend/Homestead.yaml
backend/auth.json
