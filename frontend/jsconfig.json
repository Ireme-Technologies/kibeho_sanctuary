{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@pages/*": ["src/pages/*"],
      "@sections/*": ["src/sections/*"],
      "@hooks/*": ["src/hooks/*"],
      "@data/*": ["src/data/*"],
      "@styles/*": ["src/styles/*"],
      "@router/*": ["src/router/*"],
      "@assets/*": ["src/assets/*"],
      "@utils/*": ["src/utils/*"],
      "@api/*": ["src/api/*"],
      "@context/*": ["src/context/*"],
      "@admin/*": ["src/admin/*"],
      "@i18n/*": ["src/i18n/*"]
    }
  },
  "include": ["src"]
}
